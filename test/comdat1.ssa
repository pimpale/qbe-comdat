# comdat definitions can appear in several
# translation units, the linker keeps one;
# check that they can be used as regular
# definitions, including with quoted names
# (those are not referenced directly from
# the driver because C compilers might not
# quote them in their output)

export comdat
function w $"add<int, >"(w %a, w %b) {
@start
	%c =w add %a, %b
	ret %c
}

# comdat implies export
comdat
function w $twice(w %a) {
@start
	%c =w call $"add<int, >"(w %a, w %a)
	ret %c
}

export comdat data $"SIZE<char>" = align 8 { l 2 }
export comdat data $"ZERO<int>" = { z 16 }
export comdat data $tab = { w 1, w 2, l $"add<int, >" }
comdat data $zero = align 16 { z 32 }

export data $syms = {
	l $"add<int, >",
	l $"SIZE<char>",
	l $"ZERO<int>",
}

export
function l $addr() {
@start
	ret $"add<int, >"
}

export
function l $sum() {
@start
	%a =l loadl $"SIZE<char>"
	%b =l loadl $"ZERO<int>"
	%c =l add %a, %b
	ret %c
}

