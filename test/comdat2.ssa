# skip amd64_win (pthread and tls not implemented)

# comdat thread-local data

export thread comdat data $"tls<int>" = align 4 { w 42 }
export thread comdat data $"tlz<int>" = { z 8 }

export
function w $get() {
@start
	%a =w loadw thread $"tls<int>"
	%b =w loadw thread $"tlz<int>"
	%c =w add %a, %b
	ret %c
}

export
function $set(w %a, w %b) {
@start
	storew %a, thread $"tls<int>"
	storew %b, thread $"tlz<int>"
	ret
}

